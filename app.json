{
  "expo": {
    "name": "IntelliFleet",
    "slug": "IntelliFleet",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "intellifleet",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.goffinm.intellifleet",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "IntelliFleet a besoin d'accéder à vos photos pour joindre les justificatifs d'un plein.",
          "cameraPermission": "IntelliFleet a besoin de la caméra pour prendre les photos d'un plein."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "34d08931-96b6-4aca-92a0-4749018004e0"
      }
    },
    "owner": "goffinm"
  }
}
